{
  "name": "dsh-deepseek-share",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "description": "在 DSH 输入框「+」指令面板里读取 DeepSeek 网页版分享链接中的对话内容。",
