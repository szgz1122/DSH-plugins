{
  "name": "@local/dsh-archive-center",
  "version": "0.2.1",
  "private": true,
  "description": "DSH 归档中心：在标题栏加一个「已归档」按钮，列出被归档（隐藏）的会话；可恢复（工作区缺失时按原始目录重建工作区）或经二次确认后从设备彻底删除（级联子会话）。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": ["lib", "cordis.patch.yml", "locale/*.json", "icon.svg", "README.md"],
  "scripts": {
    "test": "node test/smoke-host.mjs && node test/smoke-client.mjs"
  },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    }
  }
}
