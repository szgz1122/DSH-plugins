{
  "name": "@local/dsh-archived-sessions",
  "version": "0.1.0",
  "private": true,
  "description": "DSH 已归档会话面板：在标题栏加一个「已归档」按钮，列出被归档（隐藏）的会话并一键恢复。只改工作区记账，不改写会话日志。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": ["lib", "cordis.patch.yml", "locale/*.json", "icon.svg", "README.md"],
  "scripts": {
    "test": "node test/smoke-host.mjs && node test/smoke-client.mjs"
  },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    }
  }
}
